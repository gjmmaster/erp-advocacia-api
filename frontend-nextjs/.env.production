# ========================================
# FRONTEND - CONFIGURAÇÃO DE PRODUÇÃO
# ========================================
# Este arquivo é usado automaticamente quando você faz:
# npm run build
# npm start
#
# O Next.js carrega automaticamente .env.production em modo produção
# ========================================

# Backend API URL - Aponta para o backend em produção no Render
BACKEND_API_URL=https://erp-advocacia-api.onrender.com

# JWT Secret - DEVE ser EXATAMENTE o mesmo do backend em produção
# IMPORTANTE: Configure isso nas variáveis de ambiente do Render também!
JWT_SECRET=${JWT_SECRET}

# Node Environment
NODE_ENV=production
