# ========================================
# CONFIGURAÇÃO DE PRODUÇÃO
# ========================================
# Este arquivo define as configurações para ambiente de produção.
# Em produção, SEMPRE use PostgreSQL/CockroachDB.
# 
# IMPORTANTE: No Render.com, configure estas variáveis
# nas Environment Variables do serviço.
# ========================================

# Modo de Desenvolvimento - DEVE ser false em produção
# false = PostgreSQL/CockroachDB (PRODUÇÃO)
# true = Mock Repository (DESENVOLVIMENTO)
DEV_MODE=false

# Database - PostgreSQL/CockroachDB
# Configure a URL completa do banco de dados
DATABASE_URL=${DATABASE_URL}

# JWT Secret - Chave secreta para tokens
# IMPORTANTE: Use uma chave forte e única em produção
JWT_SECRET=${JWT_SECRET}

# Backend Port
PORT=${PORT}

# Environment
ENVIRONMENT=production

# Cloudflare R2 Storage
R2_ACCESS_KEY_ID=${R2_ACCESS_KEY_ID}
R2_SECRET_ACCESS_KEY=${R2_SECRET_ACCESS_KEY}
R2_ENDPOINT=${R2_ENDPOINT}
R2_BUCKET=${R2_BUCKET}
